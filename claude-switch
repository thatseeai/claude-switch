DEBUG = False


def debug(msg):
    if DEBUG:
        print(f"\033[36m[DEBUG] {msg}\033[0m", file=sys.stderr)


def local_settings_path():
    """현재 작업 디렉토리의 .claude/settings.local.json 경로를 반환한다."""
    return os.path.join(os.getcwd(), ".claude", "settings.local.json")


def load_json_file(path):
    """기존 JSON 파일을 읽어 파싱한다. 형식이 올바르지 않으면 명확한 에러 메시지를 출력하고 종료한다."""
    with open(path) as f:
        content = f.read()
    try:
        return json.loads(content)
    except json.JSONDecodeError as e:
        print(f"오류: {path} 파일의 JSON 형식이 올바르지 않습니다.", file=sys.stderr)
        print(f"  {e.lineno}번째 줄 {e.colno}번째 칸: {e.msg}", file=sys.stderr)
        print("  파일을 수정한 뒤 다시 시도하세요.", file=sys.stderr)
        sys.exit(1)


# ─── Usage ───────────────────────────────────────────────────────────
def keychain_pem_blocks():
    """macOS 키체인에 등록된 인증서들을 PEM 블록 리스트로 모아 반환한다.

    Charles 같은 MITM 프록시의 루트 CA는 키체인에만 등록되므로, Python 기본
    신뢰 저장소(OpenSSL/certifi)만으로는 검증에 실패한다.
    """
    keychains = [
        "/System/Library/Keychains/SystemRootCertificates.keychain",
        "/Library/Keychains/System.keychain",
    ]
    login = os.path.expanduser("~/Library/Keychains/login.keychain-db")
    if os.path.exists(login):
        keychains.append(login)

    blocks = []
    begin = "-----BEGIN CERTIFICATE-----"
    end = "-----END CERTIFICATE-----"
    for kc in keychains:
        try:
            result = subprocess.run(
                ["security", "find-certificate", "-a", "-p", kc],
                capture_output=True, text=True, timeout=15,
            )
        except (OSError, subprocess.TimeoutExpired) as e:
            debug(f"keychain_pem_blocks: {kc} 조회 실패: {e}")
            continue
        if result.returncode != 0:
            debug(f"keychain_pem_blocks: {kc} 조회 실패 (exit {result.returncode})")
            continue
        out = result.stdout
        pos = 0
        while True:
            start = out.find(begin, pos)
            if start < 0:
                break
            stop = out.find(end, start)
            if stop < 0:
                break
            pos = stop + len(end)
            blocks.append(out[start:pos] + "\n")
    debug(f"keychain_pem_blocks: 인증서 {len(blocks)}개 수집")
    return blocks


_KEYCHAIN_CTX = "unset"


def keychain_ssl_context():
    """키체인 인증서를 신뢰 목록에 추가한 SSL 컨텍스트를 반환한다. 인증서가 없으면 None."""
    global _KEYCHAIN_CTX
    if _KEYCHAIN_CTX != "unset":
        return _KEYCHAIN_CTX

    blocks = keychain_pem_blocks()
    if not blocks:
        _KEYCHAIN_CTX = None
        return None

    ctx = ssl.create_default_context()
    loaded = 0
    for pem in blocks:
        # 키체인에는 OpenSSL이 거부하는 인증서도 섞여 있을 수 있어 하나씩 넣는다.
        try:
            ctx.load_verify_locations(cadata=pem)
            loaded += 1
        except ssl.SSLError as e:
            debug(f"keychain_ssl_context: 인증서 1개 건너뜀: {e}")
    debug(f"keychain_ssl_context: 인증서 {loaded}개 로드")
    _KEYCHAIN_CTX = ctx if loaded else None
    return _KEYCHAIN_CTX


def api_urlopen(req):
    """API 요청을 보낸다. 인증서 검증에 실패하면 키체인 인증서로 한 번 더 시도한다."""
    try:
        return urllib.request.urlopen(req)
    except urllib.error.HTTPError:
        raise
    except urllib.error.URLError as e:
        if not isinstance(e.reason, ssl.SSLCertVerificationError) or sys.platform != "darwin":
            raise
        debug(f"api_urlopen: 인증서 검증 실패 ({e.reason}), 키체인 인증서로 재시도")
        ctx = keychain_ssl_context()
        if ctx is None:
            raise
        return urllib.request.urlopen(req, context=ctx)


def fetch_usage(token):
    body = json.dumps({
        "model": "claude-haiku-4-5-20251001",
        "max_tokens": 1,
        "messages": [{"role": "user", "content": "hi"}],
    }).encode()

    req = urllib.request.Request(API_URL, data=body, method="POST", headers={
        "Authorization": f"Bearer {token}",
        "Content-Type": "application/json",
        "anthropic-version": "2023-06-01",
        "anthropic-beta": "oauth-2025-04-20",
    })

    try:
        resp = api_urlopen(req)
        headers = resp.headers
    except urllib.error.HTTPError as e:
        if e.code == 401:
            return None
        headers = e.headers
    except urllib.error.URLError as e:
        return {"error": str(e.reason)}

    prefix = "anthropic-ratelimit-"
    rl_headers = {k: v for k, v in headers.items() if k.lower().startswith(prefix)}

    def get(name):
        return rl_headers.get(f"anthropic-ratelimit-{name}", "")

    return {
        "session_utilization": float(get("unified-5h-utilization") or "0"),
        "session_reset": get("unified-5h-reset") or None,
        "session_status": get("unified-5h-status") or "unknown",
        "weekly_utilization": float(get("unified-7d-utilization") or "0"),
        "weekly_reset": get("unified-7d-reset") or None,
        "weekly_status": get("unified-7d-status") or "unknown",
        "overall_status": get("unified-status") or "unknown",
        "overage_status": get("unified-overage-status") or None,
    }


def progress_bar(ratio, width=20):
    filled = round(min(ratio, 1) * width)
    empty = width - filled
    pct = f"{ratio * 100:.1f}"

    if ratio >= 0.8:
        color = "\033[31m"  # red
    elif ratio >= 0.5:
        color = "\033[33m"  # yellow
    else:
        color = "\033[32m"  # green

    reset = "\033[0m"
    bar = color + "█" * filled + reset + "░" * empty
    return f"{bar}  {pct}%"


def format_reset(reset_value, show_day=False):
    if not reset_value:
        return "unknown"
    try:
        epoch = int(reset_value)
        if epoch == 0:
            return "unknown"
        dt = datetime.fromtimestamp(epoch)
        now = datetime.now()
        diff = dt - now

        if diff.total_seconds() < 0:
            return "just reset"

        diff_min = int(diff.total_seconds() // 60)
        diff_hr = diff_min // 60
        remain_min = diff_min % 60

        time_str = dt.strftime("%-I:%M %p")
        day_prefix = f"({dt.strftime('%a')}) " if show_day else ""

        if diff_hr > 0:
            return f"{day_prefix}{time_str} ({diff_hr}h {remain_min}m)"
        return f"{day_prefix}{time_str} ({diff_min}m)"
    except (ValueError, OSError):
        return "unknown"


def display_usage(name, data):
    bold = "\033[1m"
    dim = "\033[2m"
    reset = "\033[0m"

    if data is None:
        print(f"  {bold}{name}{reset}: \033[31mtoken expired\033[0m")
        return

    if "error" in data:
        print(f"  {bold}{name}{reset}: \033[31m조회 실패\033[0m {dim}{data['error']}{reset}")
        return

    status = data["overall_status"]
    if status == "rate_limited":
        status_color = "\033[31m"
    elif status == "warning":
        status_color = "\033[33m"
    else:
        status_color = "\033[32m"

    print(f"  {bold}{name}{reset}")
    print(f"    Session (5h):  {progress_bar(data['session_utilization'])}")
    print(f"    Resets: {dim}{format_reset(data['session_reset'])}{reset}")
    print(f"    Weekly  (7d):  {progress_bar(data['weekly_utilization'])}")
    print(f"    Resets: {dim}{format_reset(data['weekly_reset'], show_day=True)}{reset}")

    overage = f"  |  Overage: {data['overage_status']}" if data["overage_status"] else ""
    print(f"    Status: {status_color}{status}{reset}{overage}")
    print()


# ─── Token file ──────────────────────────────────────────────────────
def load_tokens():
    if not os.path.isfile(TOKEN_FILE):
        print(f"토큰 파일이 없습니다: {TOKEN_FILE}")
        print()
        print("다음 형식으로 파일을 생성해주세요:")
        print()
        print("  <이름> <토큰>")
        print()
        print("예시:")
        print("  user1 AAXXYYZZ9387")
        print("  user2 BBZZABCD1234")
        sys.exit(1)

    names = []
    tokens = []
    with open(TOKEN_FILE) as f:
        for line in f:
            line = line.strip()
            if not line:
                continue
            parts = line.split(None, 1)
            if len(parts) == 2:
                names.append(parts[0])
                tokens.append(parts[1])

    if not names:
        print(f"토큰 파일에 항목이 없습니다: {TOKEN_FILE}")
        sys.exit(1)

    return names, tokens


# ─── Account selection ───────────────────────────────────────────────
def select_account(names):
    selected = 0
    count = len(names)

    def draw_menu():
        for i, name in enumerate(names):
            if i == selected:
                print(f"\r\033[1;32m> {name}\033[0m")
            else:
                print(f"\r  {name}")

    def clear_menu():
        for _ in range(count):
            sys.stdout.write("\033[A\033[2K")
        sys.stdout.flush()

    def read_key():
        ch = sys.stdin.read(1)
        if ch == "\x1b":
            rest = sys.stdin.read(2)
            return ch + rest
        return ch

    print("계정을 선택하세요 (↑↓: 이동, Enter: 선택, q: 취소):")
    print()
    draw_menu()

    fd = sys.stdin.fileno()
    old_settings = termios.tcgetattr(fd)
    try:
        tty.setraw(fd)
        while True:
            key = read_key()
            if key == "\x1b[A":  # 위
                if selected > 0:
                    selected -= 1
            elif key == "\x1b[B":  # 아래
                if selected < count - 1:
                    selected += 1
            elif key in ("\r", "\n"):  # Enter
                break
            elif key in ("q", "Q", "\x03"):  # q, Q, Ctrl+C
                termios.tcsetattr(fd, termios.TCSADRAIN, old_settings)
                print("\r\n취소되었습니다.")
                sys.exit(0)
            else:
                continue
            clear_menu()
            draw_menu()
    finally:
        termios.tcsetattr(fd, termios.TCSADRAIN, old_settings)

    return selected


# ─── 로컬 설정 env ───────────────────────────────────────────────────
def update_local_settings_env(token, token_name, proxy_url=None, use_aat=False, https_proxy=None):
    """현재 작업 디렉토리의 .claude/settings.local.json의 env 객체에 토큰 환경변수를 설정한다.
    VSCode Claude Code 확장은 이 env 객체에서 환경변수를 읽는다."""
    settings_path = local_settings_path()

    # 기존 settings.local.json 읽기 또는 새로 생성
    if os.path.isfile(settings_path):
        settings = load_json_file(settings_path)
    else:
        os.makedirs(os.path.dirname(settings_path), exist_ok=True)
        settings = {}

    env = settings.get("env", {})
    if not isinstance(env, dict):
        env = {}

    # ANTHROPIC_API_KEY: 없으면 빈 값으로 추가 (기존 값은 유지)
    env.setdefault("ANTHROPIC_API_KEY", "")

    # CLAUDE_CODE_OAUTH_NAME: 계정 이름 설정
    env["CLAUDE_CODE_OAUTH_NAME"] = token_name

    # 토큰 변수: --aat면 ANTHROPIC_AUTH_TOKEN, 아니면 CLAUDE_CODE_OAUTH_TOKEN
    token_var = "ANTHROPIC_AUTH_TOKEN" if use_aat else "CLAUDE_CODE_OAUTH_TOKEN"
    other_var = "CLAUDE_CODE_OAUTH_TOKEN" if use_aat else "ANTHROPIC_AUTH_TOKEN"
    env[token_var] = token
    # 반대편 토큰 변수가 남아있으면 제거 (모드 전환 시 잔여 항목 정리)
    env.pop(other_var, None)

    # ANTHROPIC_BASE_URL: proxy_url가 지정된 경우에만 설정, 없으면 제거
    if proxy_url is not None:
        env["ANTHROPIC_BASE_URL"] = proxy_url
    else:
        env.pop("ANTHROPIC_BASE_URL", None)

    # HTTPS_PROXY: https_proxy가 지정된 경우에만 설정, 없으면 제거
    if https_proxy is not None:
        env["HTTPS_PROXY"] = https_proxy
    else:
        env.pop("HTTPS_PROXY", None)

    settings["env"] = env

    with open(settings_path, "w") as f:
        json.dump(settings, f, indent=2, ensure_ascii=False)
        f.write("\n")

    print(".claude/settings.local.json 업데이트 완료")


def clear_local_settings_env(quiet=False):
    """settings.local.json의 env에서 토큰/프록시 관련 변수를 제거한다.

    quiet=True이면 제거할 대상이 없을 때 아무것도 출력하지 않고, 실제로 제거한
    경우에만 간단한 메시지를 출력한다. (일반 모드에서 settings.local.json이
    환경변수보다 우선하는 것을 막기 위해 호출)
    """
    settings_path = local_settings_path()

    if not os.path.isfile(settings_path):
        if not quiet:
            print(".claude/settings.local.json 파일이 없습니다.")
        return

    settings = load_json_file(settings_path)

    env = settings.get("env", {})
    if not isinstance(env, dict) or not env:
        if not quiet:
            print("env 항목이 없습니다.")
        return

    remove_names = {"ANTHROPIC_API_KEY", "CLAUDE_CODE_OAUTH_TOKEN", "ANTHROPIC_AUTH_TOKEN", "CLAUDE_CODE_OAUTH_NAME", "ANTHROPIC_BASE_URL", "HTTPS_PROXY"}
    removed = [name for name in remove_names if name in env]
    if not removed:
        if not quiet:
            print("env 항목이 없습니다.")
        return
    for name in removed:
        env.pop(name, None)

    if env:
        settings["env"] = env
    else:
        del settings["env"]

    with open(settings_path, "w") as f:
        json.dump(settings, f, indent=2, ensure_ascii=False)
        f.write("\n")

    if quiet:
        print("기존 .claude/settings.local.json의 토큰 정보를 제거했습니다 (환경변수 우선 적용).")
    else:
        print(".claude/settings.local.json에서 토큰 정보를 제거했습니다.")


def update_session_start_hook():
    """현재 작업 디렉토리의 .claude/settings.local.json에 SessionStart 알림 hook을 추가한다."""
    settings_path = local_settings_path()
    debug(f"update_session_start_hook: settings_path={settings_path}")

    if os.path.isfile(settings_path):
        settings = load_json_file(settings_path)
        debug(f"update_session_start_hook: 기존 파일 로드, keys={list(settings.keys())}")
    else:
        os.makedirs(os.path.dirname(settings_path), exist_ok=True)
        settings = {}
        debug("update_session_start_hook: 파일 없음, 새로 생성")

    hooks = settings.get("hooks", {})
    session_start = hooks.get("SessionStart", [])
    debug(f"update_session_start_hook: 기존 SessionStart 항목 수={len(session_start)}")

    # 중복 체크: command에 CLAUDE_CODE_OAUTH_NAME, osascript, notify-send 포함 여부
    duplicate_keywords = ("CLAUDE_CODE_OAUTH_NAME", "osascript", "notify-send")
    for i, matcher_group in enumerate(session_start):
        for hook in matcher_group.get("hooks", []):
            cmd = hook.get("command", "")
            match = all(kw in cmd for kw in duplicate_keywords)
            debug(f"update_session_start_hook: matcher_group[{i}] 중복체크={match}, command={cmd[:80]}...")
            if match:
                debug(f"update_session_start_hook: 중복 발견(matcher_group[{i}]), 스킵")
                return

    noti_hook = {
        "matcher": "startup",
        "hooks": [
            {
                "type": "command",
                "command": '[ -n "${CLAUDE_CODE_OAUTH_NAME}" ] && { if [ "$(uname)" = "Darwin" ]; then osascript -e "display notification \\"${CLAUDE_CODE_OAUTH_NAME} 토큰 사용\\" with title \\"Claude Code\\""; else notify-send "Claude Code" "${CLAUDE_CODE_OAUTH_NAME} 토큰 사용"; fi; } || true',
            }
        ],
    }

    session_start.append(noti_hook)
    hooks["SessionStart"] = session_start
    settings["hooks"] = hooks

    debug(f"update_session_start_hook: hook 추가 완료, 저장 중")
    with open(settings_path, "w") as f:
        json.dump(settings, f, indent=2, ensure_ascii=False)
        f.write("\n")


def remove_session_start_hook():
    """현재 작업 디렉토리의 .claude/settings.local.json에서 SessionStart 알림 hook을 제거한다."""
    settings_path = local_settings_path()
    debug(f"remove_session_start_hook: settings_path={settings_path}")

    if not os.path.isfile(settings_path):
        debug("remove_session_start_hook: 파일 없음, 스킵")
        return

    settings = load_json_file(settings_path)
    debug(f"remove_session_start_hook: 기존 파일 로드, keys={list(settings.keys())}")

    hooks = settings.get("hooks", {})
    session_start = hooks.get("SessionStart", [])
    debug(f"remove_session_start_hook: SessionStart 항목 수={len(session_start)}")
    if not session_start:
        debug("remove_session_start_hook: SessionStart 비어있음, 스킵")
        return

    duplicate_keywords = ("CLAUDE_CODE_OAUTH_NAME", "osascript", "notify-send")
    changed = False
    filtered = []
    for i, matcher_group in enumerate(session_start):
        inner_hooks = matcher_group.get("hooks", [])
        remaining = [h for h in inner_hooks if not all(kw in h.get("command", "") for kw in duplicate_keywords)]
        debug(f"remove_session_start_hook: matcher_group[{i}] inner={len(inner_hooks)} remaining={len(remaining)}")
        if len(remaining) < len(inner_hooks):
            changed = True
        if remaining:
            matcher_group["hooks"] = remaining
            filtered.append(matcher_group)

    debug(f"remove_session_start_hook: changed={changed} filtered={len(filtered)} original={len(session_start)}")
    if not changed:
        debug("remove_session_start_hook: 변경 없음, 스킵")
        return

    if filtered:
        hooks["SessionStart"] = filtered
    else:
        del hooks["SessionStart"]
        debug("remove_session_start_hook: SessionStart 키 삭제")

    if hooks:
        settings["hooks"] = hooks
    else:
        del settings["hooks"]
        debug("remove_session_start_hook: hooks 키 삭제")

    debug("remove_session_start_hook: 저장 중")
    with open(settings_path, "w") as f:
        json.dump(settings, f, indent=2, ensure_ascii=False)
        f.write("\n")


def ensure_git_root_cwd(stay_here=False):
    """현재 디렉토리가 git 저장소이면 최상위 디렉토리로 이동한다.
    git 관리되지 않는 경우 경고 후 사용자 확인을 받는다.
    stay_here가 True이면 디렉토리를 이동하지 않고 현재 디렉토리를 유지한다."""
    if stay_here:
        debug(f"ensure_git_root_cwd: --here 지정, 현재 디렉토리 유지 {os.getcwd()}")
        return
    try:
        result = subprocess.run(
            ["git", "rev-parse", "--show-toplevel"],
            capture_output=True, text=True,
        )
    except FileNotFoundError:
        print("\033[33m경고: git 명령을 찾을 수 없습니다. 현재 디렉토리에서 진행합니다.\033[0m")
        result = None

    if result is not None and result.returncode == 0:
        toplevel = result.stdout.strip()
        if toplevel and toplevel != os.getcwd():
            debug(f"ensure_git_root_cwd: chdir {os.getcwd()} -> {toplevel}")
            os.chdir(toplevel)
        return

    print(f"\033[33m경고: 현재 디렉토리는 git으로 관리되지 않습니다: {os.getcwd()}\033[0m")
    try:
        answer = input("계속 진행하시겠습니까? (y/N): ").strip().lower()
    except EOFError:
        answer = ""
    if answer not in ("y", "yes"):
        print("중단되었습니다.")
        sys.exit(1)


def check_settings_local_gitignore():
    # git 저장소인지 확인
    try:
        result = subprocess.run(
            ["git", "rev-parse", "--is-inside-work-tree"],
            capture_output=True, text=True,
        )
        if result.returncode != 0:
            return
    except FileNotFoundError:
        return

    # 토큰이 저장되는 .claude/settings.local.json이 gitignore로 무시되는지 확인
    entry = ".claude/settings.local.json"
    result = subprocess.run(
        ["git", "check-ignore", "-q", entry],
        capture_output=True,
    )
    if result.returncode != 0:
        gitignore_path = ".gitignore"
        with open(gitignore_path, "a") as f:
            f.write(f"\n{entry}\n")
        print(f"\033[32m✓ {entry}을 .gitignore에 추가했습니다.\033[0m")


# ─── Main ────────────────────────────────────────────────────────────
def run_hook(hook_path, name, token, cwd):
    """CS_CLAUDE_AUTH_* 환경변수를 설정한 뒤 hook 프로그램을 실행한다.

    cwd(claude-switch가 호출된 원래 디렉토리, git 최상위로 이동하기 전 위치)를
    작업 디렉토리로 사용한다.
    hook가 0이 아닌 종료 코드로 끝나면 에러를 출력하고 그 코드로 종료(abort)한다.
    """
    os.environ["CS_CLAUDE_AUTH_NAME"] = name
    os.environ["CS_CLAUDE_AUTH_TOKEN"] = token
    debug(f"run_hook: {hook_path} 실행 (cwd={cwd}, CS_CLAUDE_AUTH_NAME={name})")
    result = subprocess.run([hook_path], cwd=cwd)
    if result.returncode != 0:
        print(f"오류: hook 프로그램이 종료 코드 {result.returncode}로 실패했습니다.",
              file=sys.stderr)
        sys.exit(result.returncode)


# 값을 받지 않는 옵션
FLAG_OPTIONS = {
    "--help", "-h",
    "--list",
    "--usages",
    "--vscode",
    "--vscode-clear",
    "--aat",
    "--here",
    "--debug",
}

# 값을 하나 받는 옵션: {옵션: (에러 메시지에 쓸 설명(조사 포함), 사용법에 쓸 표기)}
VALUE_OPTIONS = {
    "--get-token": ("이름을", "이름"),
    "--proxy": ("[HOST:]PORT를", "[HOST:]PORT"),
    "--https-proxy": ("URL 또는 PORT를", "URL|PORT"),
    "--hook": ("실행할 PROGRAM을", "PROGRAM"),
}

KNOWN_OPTIONS = sorted(FLAG_OPTIONS | set(VALUE_OPTIONS))


def unknown_arg_error(arg):
    """claude-switch가 모르는 인자를 만났을 때 안내를 출력하고 종료한다."""
    if arg.startswith("-"):
        print(f"오류: 알 수 없는 옵션입니다: {arg}", file=sys.stderr)
        # 하이픈/언더스코어 혼동 같은 오타를 잡아 준다
        candidates = difflib.get_close_matches(arg.replace("_", "-"), KNOWN_OPTIONS, n=1, cutoff=0.7)
        if candidates:
            print(f"  혹시 {candidates[0]} 를 의도하셨나요?", file=sys.stderr)
    else:
        print(f"오류: 알 수 없는 인자입니다: {arg}", file=sys.stderr)
    print("  claude에 전달할 인자는 `--` 뒤에 지정하세요: claude-switch [옵션] -- <claude 인자...>",
          file=sys.stderr)
    print("  사용 가능한 옵션은 claude-switch --help 로 확인할 수 있습니다.", file=sys.stderr)
    sys.exit(1)


def parse_own_args(argv):
    """claude-switch 자체 옵션을 앞에서부터 순서대로 파싱한다.

    argv는 프로그램 이름과 `--` 이후를 제외한 인자 목록이다. 여기에는
    claude-switch 옵션만 올 수 있으며, 모르는 인자를 만나면 즉시 종료한다.
    반환값은 {옵션: 값} 딕셔너리(값을 받지 않는 옵션은 True).
    """
    opts = {}
    i = 0
    while i < len(argv):
        arg = argv[i]
        if arg in FLAG_OPTIONS:
            opts[arg] = True
            i += 1
        elif arg in VALUE_OPTIONS:
            desc, usage = VALUE_OPTIONS[arg]
            if i + 1 >= len(argv) or argv[i + 1].startswith("-"):
                print(f"오류: {arg} 옵션에 {desc} 지정해야 합니다.", file=sys.stderr)
                print(f"사용법: claude-switch {arg} <{usage}>", file=sys.stderr)
                sys.exit(1)
            opts[arg] = argv[i + 1]
            i += 2
        else:
            unknown_arg_error(arg)
    return opts


def print_help():
    print("사용법: claude-switch [옵션] [-- claude 인자...]")
    print()
    print("옵션:")
    print("  --help, -h          이 도움말을 출력합니다")
    print("  --list              등록된 계정 이름을 나열합니다")
    print("  --get-token NAME    해당 계정의 토큰을 출력합니다")
    print("  --usages            모든 계정의 사용량을 표시합니다")
    print("  --vscode            선택한 계정의 토큰을 .claude/settings.local.json의 env에 설정합니다")
    print("  --vscode-clear      .claude/settings.local.json의 env에서 토큰 정보를 제거합니다")
    print("  --proxy [HOST:]PORT ANTHROPIC_BASE_URL=http://[HOST:]PORT 를 설정합니다 (HOST 생략 시 localhost)")
    print("  --https-proxy URL   HTTPS_PROXY=URL 을 설정합니다 (PORT만 지정 시 http://127.0.0.1:PORT)")
    print("                      (--proxy 와 함께 사용할 수 없습니다)")
    print("  --aat               토큰을 CLAUDE_CODE_OAUTH_TOKEN 대신 ANTHROPIC_AUTH_TOKEN 에 설정합니다")
    print("  --hook PROGRAM      환경변수(CS_CLAUDE_AUTH_NAME/CS_CLAUDE_AUTH_TOKEN) 설정 후 PROGRAM 실행")
    print("                      (--vscode 또는 claude 실행 모드에서만 동작)")
    print("  --here              git 최상위 디렉토리로 이동하지 않고 현재 디렉토리에서 실행합니다")
    print("  --debug             디버그 메시지를 출력합니다")
    print()
    print("`--` 앞에는 위 옵션만 올 수 있습니다. claude에 넘길 인자는 `--` 뒤에 지정하세요.")
    print("  예: claude-switch --aat -- --model opus -c")
    print()
    print(f"토큰 파일: {TOKEN_FILE}")


def main():
    global DEBUG

    # `--` 구분자 기준으로 claude-switch 옵션과 claude 전달 인자를 분리
    if "--" in sys.argv:
        sep_idx = sys.argv.index("--")
        own_argv = sys.argv[1:sep_idx]
        passthrough_argv = sys.argv[sep_idx + 1:]
    else:
        own_argv = sys.argv[1:]
        passthrough_argv = []

    # 1단계: 옵션 검증. 계정 목록을 읽거나 usage를 조회하기 전에,
    # 알 수 없는 옵션·빠진 옵션 값·잘못된 조합을 모두 여기서 걸러낸다.
    opts = parse_own_args(own_argv)

    DEBUG = "--debug" in opts
    debug(f"main: opts={opts} passthrough_argv={passthrough_argv}")
    debug(f"main: cwd={os.getcwd()}")

    # --help, -h: 도움말 출력 후 종료
    if "--help" in opts or "-h" in opts:
        print_help()
        return

    # --aat: ANTHROPIC_AUTH_TOKEN 사용. 없으면 기본 동작(CLAUDE_CODE_OAUTH_TOKEN 사용).
    use_aat = "--aat" in opts

    # --here: git 최상위 디렉토리로 이동하지 않고 현재 디렉토리 유지.
    stay_here = "--here" in opts

    # --proxy와 --https-proxy는 동시에 지정할 수 없다 (하나만 허용)
    if "--proxy" in opts and "--https-proxy" in opts:
        print("오류: --proxy 와 --https-proxy 는 함께 사용할 수 없습니다. 하나만 지정하세요.",
              file=sys.stderr)
        sys.exit(1)

    # --proxy [HOST:]PORT: ANTHROPIC_BASE_URL 설정용 호스트/포트 파싱
    proxy_url = None
    if "--proxy" in opts:
        target = opts["--proxy"]
        if ":" in target:
            host, _, port_str = target.rpartition(":")
            if not host:
                print(f"오류: HOST가 비어있습니다: {target}", file=sys.stderr)
                sys.exit(1)
        else:
            host = "localhost"
            port_str = target
        if not port_str.isdigit():
            print(f"오류: 포트 번호가 올바르지 않습니다: {port_str}", file=sys.stderr)
            sys.exit(1)
        proxy_url = f"http://{host}:{int(port_str)}"

    # --https-proxy URL: HTTPS_PROXY 설정값 파싱 (포트 번호만 주면 http://127.0.0.1:PORT)
    https_proxy = None
    if "--https-proxy" in opts:
        target = opts["--https-proxy"]
        if target.isdigit():
            https_proxy = f"http://127.0.0.1:{int(target)}"
        elif "://" in target:
            https_proxy = target
        else:
            print(f"오류: URL 또는 포트 번호가 올바르지 않습니다: {target}", file=sys.stderr)
            print("예: --https-proxy http://127.0.0.1:3002 또는 --https-proxy 3002", file=sys.stderr)
            sys.exit(1)
        debug(f"main: https_proxy={https_proxy}")

    # --hook PROGRAM: 계정 선택 후 환경변수를 설정하고 실행할 프로그램 파싱/검증
    # (상대 경로 해석과 실행 cwd 모두 사용자의 원래 위치 기준이 되도록
    #  ensure_git_root_cwd가 cwd를 git 최상위로 바꾸기 전에 처리한다)
    hook_path = None
    hook_cwd = os.getcwd()
    if "--hook" in opts:
        hook_program = opts["--hook"]
        resolved = shutil.which(hook_program)
        if resolved is None:
            print(f"오류: hook 프로그램을 찾을 수 없거나 실행 권한이 없습니다: {hook_program}",
                  file=sys.stderr)
            sys.exit(1)
        hook_path = os.path.abspath(resolved)

        # --hook은 --vscode 모드와 일반(claude 실행) 모드에서만 동작한다.
        incompatible = {"--list", "--get-token", "--usages", "--vscode-clear"}
        used_incompatible = incompatible & set(opts)
        if used_incompatible:
            print(f"오류: --hook은 {', '.join(sorted(used_incompatible))} 와 함께 사용할 수 없습니다."
                  " (--vscode 또는 claude 실행 모드에서만 동작)", file=sys.stderr)
            sys.exit(1)
        debug(f"main: hook_path={hook_path}")

    names, tokens = load_tokens()

    # --list: 계정 이름 목록 출력 후 종료
    if "--list" in opts:
        for name in names:
            print(name)
        return

    # --get-token NAME: 해당 이름의 토큰 출력 후 종료
    if "--get-token" in opts:
        target = opts["--get-token"]
        if target not in names:
            print(f"'{target}' 계정을 찾을 수 없습니다.", file=sys.stderr)
            print(f"사용 가능한 계정: {', '.join(names)}", file=sys.stderr)
            sys.exit(1)
        print(tokens[names.index(target)])
        return

    # --usages: 모든 토큰의 usage 표시 후 종료
    if "--usages" in opts:
        print("\n\033[1mClaude API Rate Limits\033[0m")
        print("━" * 41)
        print()
        for name, token in zip(names, tokens):
            data = fetch_usage(token)
            display_usage(name, data)
        return

    # --vscode: 계정 선택 후 .claude/settings.local.json의 env 업데이트
    if "--vscode" in opts:
        debug("main: --vscode 모드")
        ensure_git_root_cwd(stay_here)
        selected = select_account(names)
        print()
        print(f"선택: {names[selected]}")
        print()

        # 선택한 토큰의 usage 표시
        print("\033[1mClaude API Rate Limits\033[0m")
        print("━" * 41)
        print()
        data = fetch_usage(tokens[selected])
        display_usage(names[selected], data)

        update_local_settings_env(tokens[selected], names[selected], proxy_url, use_aat, https_proxy)
        debug("main: update_session_start_hook 호출")
        update_session_start_hook()
        check_settings_local_gitignore()
        if hook_path is not None:
            run_hook(hook_path, names[selected], tokens[selected], hook_cwd)
        return

    # --vscode-clear: .claude/settings.local.json의 env에서 토큰 제거
    if "--vscode-clear" in opts:
        debug("main: --vscode-clear 모드")
        ensure_git_root_cwd(stay_here)
        clear_local_settings_env()
        debug("main: remove_session_start_hook 호출")
        remove_session_start_hook()
        return

    # 일반 모드: 계정 선택
    debug("main: 일반 모드")
    ensure_git_root_cwd(stay_here)
    sys.stdout.write("\033c")
    sys.stdout.flush()
    selected = select_account(names)

    print()
    print(f"선택: {names[selected]}")
    print()

    # 선택한 토큰의 usage 표시
    print("\033[1mClaude API Rate Limits\033[0m")
    print("━" * 41)
    print()
    data = fetch_usage(tokens[selected])
    display_usage(names[selected], data)

    # settings.local.json의 토큰 env 제거 (환경변수보다 우선하므로 선택 계정이 무시되는 것을 방지)
    clear_local_settings_env(quiet=True)

    # SessionStart hook 추가
    debug("main: update_session_start_hook 호출")
    update_session_start_hook()

    # claude 실행: `--` 앞은 전부 claude-switch 옵션이므로, 뒤쪽 인자만 그대로 넘긴다
    claude_args = passthrough_argv
    debug(f"main: claude_args={claude_args}")
    if proxy_url is not None:
        os.environ["ANTHROPIC_BASE_URL"] = proxy_url
    if https_proxy is not None:
        os.environ["HTTPS_PROXY"] = https_proxy
    if use_aat:
        os.environ["ANTHROPIC_AUTH_TOKEN"] = tokens[selected]
    else:
        os.environ["CLAUDE_CODE_OAUTH_TOKEN"] = tokens[selected]
    os.environ["CLAUDE_CODE_OAUTH_NAME"] = names[selected]
    if hook_path is not None:
        run_hook(hook_path, names[selected], tokens[selected], hook_cwd)
    os.execvp("claude", ["claude"] + claude_args)


if __name__ == "__main__":
    main()
